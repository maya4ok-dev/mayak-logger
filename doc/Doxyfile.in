PROJECT_NAME           = @PROJECT_NAME@
PROJECT_NUMBER         = @PROJECT_VERSION@
OUTPUT_DIRECTORY       = @CMAKE_CURRENT_BINARY_DIR@/docs
INPUT                  = @CMAKE_CURRENT_SOURCE_DIR@/include @CMAKE_CURRENT_SOURCE_DIR@/doc/groups.dox
FILE_PATTERNS          = *.h *.hpp *.c *.cpp *.dox
RECURSIVE              = YES

GENERATE_LATEX         = NO
GENERATE_HTML          = YES
GENERATE_MAN           = NO

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES

